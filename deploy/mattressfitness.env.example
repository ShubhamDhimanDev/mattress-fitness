# Environment file for the storefront on a VPS (P9-12). TEMPLATE with names and placeholders only.
# Install as /etc/mattressfitness/env, owner root, group root, mode 0600. NEVER commit the filled-in file, paste it
# into a chat or ticket, or print it (`cat`, `systemctl show -p Environment`, `ps e`). Meaning, exposure and failure
# behaviour of every name: docs/deployment/DEPLOYMENT.md ("Environment variables"). A name without PUBLIC_ stays on the
# server; a PUBLIC_ name is sent to browsers.
# Format (systemd EnvironmentFile): one NAME=value per line, no `export`, no spaces around `=`. Wrap a value that
# contains spaces, `#` or quotes in single quotes.
# Host settings (NODE_ENV, PORT, BIND_HOST, TRUST_PROXY) are in the service unit, not here.

# ---- Required for a store to work ----------------------------------------------------------------------------------
# At least 32 random characters, different per environment and from DELIVERY_COOKIE_SECRET. Generate on the server with:
#   openssl rand -base64 48
SESSION_SECRET=<GENERATE_32_PLUS_RANDOM_CHARACTERS>
# The <shop>.myshopify.com name of the client's store (the webhook order read needs this exact form).
PUBLIC_STORE_DOMAIN=<SHOP>.myshopify.com
# The channel's public Storefront API token (public by design, but still not committed).
PUBLIC_STOREFRONT_API_TOKEN=<STOREFRONT_API_PUBLIC_TOKEN>
# The store's checkout domain.
PUBLIC_CHECKOUT_DOMAIN=<CHECKOUT_DOMAIN>
PUBLIC_STOREFRONT_ID=<HYDROGEN_OR_HEADLESS_CHANNEL_ID>

# ---- Required for specific features (the feature fails closed without them) ----------------------------------------
DELIVERY_COOKIE_SECRET=<GENERATE_32_PLUS_DIFFERENT_RANDOM_CHARACTERS>
# The live origin, https only, no trailing path. Without it canonical links, structured data and the sitemap are omitted.
PUBLIC_SITE_URL=https://<YOUR_DOMAIN>
# Optional override of the Site settings support phone in Shopify admin.
#PUBLIC_SUPPORT_PHONE=
# Non-secret JSON on ONE line, at most 100,000 characters (schema: storefront/app/lib/offers-runtime/config.ts).
# Missing or invalid in production: checkout is paused with an explanation.
OFFER_CONFIG_JSON='<ONE_LINE_JSON>'
# Set to false only to run without offers on purpose.
#OFFERS_ENABLED=false
# Exactly true turns the gift picker on; leave unset until V-03 passes (blocker B-21).
#PUBLIC_GIFT_PICKER_ENABLED=
# Exactly true shows Extend surfaces. EXTEND_API_HOST must be the demo or production Extend host, never the local mock.
#PUBLIC_EXTEND_ENABLED=
#EXTEND_API_HOST=
#EXTEND_STORE_ID=
#EXTEND_ACCESS_TOKEN=
# self (default), extend-app or off.
#EXTEND_ORDER_SYNC=
# The Dev Dashboard app's client secret; it also verifies webhook signatures. Unset: /webhooks/shopify answers 503.
#SHOPIFY_APP_CLIENT_SECRET=
# The separate read_orders-only Admin token (never the catalog import token).
#SHOPIFY_ADMIN_API_ACCESS_TOKEN=

# ---- Never set on a server ------------------------------------------------------------------------------------------
# SHOPIFY_STORE_DOMAIN, SHOPIFY_ALLOWED_STORES, any write-capable Shopify token, EXTEND_MOCK_*: they belong to developer
# scripts only (DEPLOYMENT.md, "Scripts only").
