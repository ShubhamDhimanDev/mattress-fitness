# Placeholder names only. Never put values in this file; never commit a real .env.
# Copy to storefront/.env (ignored by git) and fill in locally. Production values live in the
# hosting platform's secret store. Names are reconciled with the Hydrogen scaffold in task P1-03.
# PUBLIC_ variables are exposed to browsers by Hydrogen's convention; the rest are server-only.
# Details and origin of each variable: docs/deployment/DEPLOYMENT.md

# --- Hydrogen and Shopify (origin: Hydrogen or Headless sales channel, store admin) ---
SESSION_SECRET=
PUBLIC_STORE_DOMAIN=
PUBLIC_STOREFRONT_ID=
PUBLIC_STOREFRONT_API_TOKEN=
PRIVATE_STOREFRONT_API_TOKEN=
PUBLIC_CHECKOUT_DOMAIN=
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_URL=
SHOP_ID=
# The storefront public origin (https://www.example.com). Canonical links and structured data use it instead of the request Host header; without it they are omitted outside development.
PUBLIC_SITE_URL=

# --- Shopify Admin API and webhooks (server only; custom app with least-privilege scopes) ---
SHOPIFY_APP_CLIENT_ID=
# The app client secret also verifies webhook signatures (ADR-0009 addendum); there is no separate webhook secret.
SHOPIFY_APP_CLIENT_SECRET=
SHOPIFY_ADMIN_API_ACCESS_TOKEN=

# --- Local scripts only (scripts/catalog, scripts/shopify): never set these in the storefront deployment ---
SHOPIFY_STORE_DOMAIN=
# Comma-separated myshopify domains the scripts may write to; live runs refuse any other store.
SHOPIFY_ALLOWED_STORES=
SHOPIFY_ADMIN_API_VERSION=

# --- Extend (server only; values supplied by Extend, see docs/integrations/EXTEND.md) ---
EXTEND_API_HOST=
EXTEND_STORE_ID=
EXTEND_ACCESS_TOKEN=
EXTEND_ORDER_SYNC=
PUBLIC_EXTEND_ENABLED=

# --- Reviews (server only; only if Judge.me is chosen) ---
JUDGEME_PRIVATE_API_TOKEN=

# --- Marketing, analytics and widgets (public identifiers from client accounts) ---
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_KLAVIYO_COMPANY_ID=
PUBLIC_AFFIRM_PUBLIC_KEY=
PUBLIC_MAPS_API_KEY=

# --- Offers (server only) ---
# JSON with the offer rules and the delivery zone. Temporary seam until the metaobject-backed rules exist (P4-12); missing or invalid means no offers.
OFFER_CONFIG_JSON=
