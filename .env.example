# Placeholder names only. Never put values in this file; never commit a real .env.
# Copy to storefront/.env (ignored by git) and fill in locally. Production values live in the
# hosting platform's secret store. Names are reconciled with the Hydrogen scaffold in task P1-03.
# PUBLIC_ variables are exposed to browsers by Hydrogen's convention; the rest are server-only.
# Details and origin of each variable: docs/deployment/DEPLOYMENT.md

# --- Hydrogen and Shopify (origin: Hydrogen or Headless sales channel, store admin) ---
SESSION_SECRET=
# Signs the delivery ZIP cookie. A different value from SESSION_SECRET, at least 32 random characters; shorter values disable the ZIP cookie (fail closed).
DELIVERY_COOKIE_SECRET=
PUBLIC_STORE_DOMAIN=
PUBLIC_STOREFRONT_ID=
PUBLIC_STOREFRONT_API_TOKEN=
PRIVATE_STOREFRONT_API_TOKEN=
PUBLIC_CHECKOUT_DOMAIN=
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_URL=
SHOP_ID=
# The storefront public origin (https://www.example.com). Canonical links and structured data use it instead of the request Host header; without it they are omitted outside development.
PUBLIC_SITE_URL=
# The client's support phone (a US number, any common format). No phone link is shown anywhere until it is set and valid; development shows a labelled placeholder (REQ-CNT-001, B-15).
PUBLIC_SUPPORT_PHONE=
# Opt-in: the handle of the Shopify navigation menu that drives the header and mega menu (REQ-NAV-002), for example main-menu. Empty keeps the fixed navigation and makes no menu request.
PUBLIC_NAV_MENU_HANDLE=

# --- Shopify Admin API and webhooks (server only; custom app with least-privilege scopes) ---
SHOPIFY_APP_CLIENT_ID=
# The app client secret also verifies webhook signatures (ADR-0009 addendum); there is no separate webhook secret.
SHOPIFY_APP_CLIENT_SECRET=
# Read by the storefront webhook route to fetch ONE order for the Extend sync. It must be a SEPARATE token with the order read
# scope only (read_orders); never reuse the catalog import token that scripts/catalog uses, which can write (EXTEND.md section 9).
# The shop is taken from PUBLIC_STORE_DOMAIN, which must be the <shop>.myshopify.com domain for this read to work.
SHOPIFY_ADMIN_API_ACCESS_TOKEN=

# --- Local scripts only (scripts/catalog, scripts/shopify): never set these in the storefront deployment ---
SHOPIFY_STORE_DOMAIN=
# Comma-separated myshopify domains the scripts may write to; live runs refuse any other store.
SHOPIFY_ALLOWED_STORES=
SHOPIFY_ADMIN_API_VERSION=

# --- Extend (server only; values supplied by Extend, see docs/integrations/EXTEND.md) ---
EXTEND_API_HOST=
EXTEND_STORE_ID=
EXTEND_ACCESS_TOKEN=
EXTEND_ORDER_SYNC=
PUBLIC_EXTEND_ENABLED=

# --- Reviews (server only; only if Judge.me is chosen) ---
JUDGEME_PRIVATE_API_TOKEN=

# --- Marketing, analytics and widgets (public identifiers from client accounts) ---
# Analytics (P7-01, docs/integrations/ANALYTICS.md). Each id is public; leave it empty and that provider loads nothing and adds no host to the Content Security Policy.
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_META_PIXEL_ID=
# opt-in (default, stricter: nothing is loaded or sent until the shopper agrees) or opt-out. Any other value means opt-in. Which one applies is a legal decision for the client (Q-012, T-16).
PUBLIC_CONSENT_MODE=
# Reserved: the signup does not read it (Klaviyo says its browser endpoint must not be called from a server; docs/integrations/KLAVIYO.md).
PUBLIC_KLAVIYO_COMPANY_ID=
PUBLIC_AFFIRM_PUBLIC_KEY=
PUBLIC_MAPS_API_KEY=

# --- Offers (server only) ---
# JSON with the offer rules and the delivery zone. Temporary seam until the metaobject-backed rules exist (P4-12); missing or invalid means no offers.
OFFER_CONFIG_JSON=
# Explicit "offers off" switch. Set to false ONLY to run without offers on purpose. In production a missing or invalid OFFER_CONFIG_JSON does not mean "off": checkout is paused with an explanation until it is fixed. Dev and mock stores run without it.
OFFERS_ENABLED=
# Gift picker in the cart. Off unless set to true: turn it on only after the gift discount is verified on a development store (V-03).
PUBLIC_GIFT_PICKER_ENABLED=

# --- Klaviyo email signup (server only; P7-02, docs/integrations/KLAVIYO.md) ---
# The signup form is not rendered, and no signup code is requested, unless BOTH values below are set and well-formed.
# A Klaviyo private key limited to the scopes lists:write, profiles:write and subscriptions:write. Never PUBLIC_.
KLAVIYO_PRIVATE_API_KEY=
# The id of the list that signups join. Its opt-in setting must be double opt-in (docs/integrations/KLAVIYO.md, section 6).
KLAVIYO_LIST_ID=
# The exact text "true" shows the optional text-message fields. Default off. A production build also needs the SMS wording
# to be client-approved in code (lib/signup/consent.ts); development shows the placeholder wording.
PUBLIC_KLAVIYO_SMS_ENABLED=

# --- Guest order tracking (server only) ---
# Which request header carries the real client address for the lookup rate limiter. On the VPS behind nginx: x-real-ip. Unset means one shared bucket for everyone (safe, but can lock shoppers out under load). Never oxygen-buyer-ip on the VPS.
TRUSTED_CLIENT_IP_HEADER=
# Optional: extra carrier domains (comma-separated bare domains) that tracking links may point to, besides UPS, FedEx, USPS, DHL and OnTrac.
TRACKING_LINK_HOSTS=
