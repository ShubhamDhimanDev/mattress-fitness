# Names only. Never put values in this file and never commit a filled copy (.env and .env.* are git-ignored).
#
# Copy it to a file named for the mode you start, then fill it in:
#   storefront/.env.demo   ->   npm run dev -- --port 3400 --mode demo      (your development store)
#   storefront/.env        ->   npm run dev                                 (the default; mock.shop or your store)
# The full list with origins, and the scripts' own variables, are in ../.env.example and ../docs/deployment/DEPLOYMENT.md.
# A name with PUBLIC_ in front is sent to the browser; every other name is server-only.
# Secrets: generate one with  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---------------------------------------------------------------------------------------------------------------------
# 1. REQUIRED to start the storefront against a Shopify store
# ---------------------------------------------------------------------------------------------------------------------
# The store's <name>.myshopify.com domain.
PUBLIC_STORE_DOMAIN=
# The domain Shopify's hosted checkout answers on; for a development store the same myshopify.com domain.
PUBLIC_CHECKOUT_DOMAIN=
# The 32-character PUBLIC access token of the Hydrogen (or Headless) sales channel's storefront.
PUBLIC_STOREFRONT_API_TOKEN=
# Signs the session cookie. At least 32 random characters; the app refuses to serve without it.
SESSION_SECRET=
# Signs the delivery ZIP cookie. A DIFFERENT value from SESSION_SECRET, at least 32 random characters; shorter disables the ZIP cookie.
DELIVERY_COOKIE_SECRET=

# ---------------------------------------------------------------------------------------------------------------------
# 2. Customer accounts (sign-in). Leave empty and the account pages show a fixed "not available" page.
# ---------------------------------------------------------------------------------------------------------------------
PUBLIC_STOREFRONT_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
SHOP_ID=
# Server-side token of the storefront; only needed when the channel gives one.
PRIVATE_STOREFRONT_API_TOKEN=

# ---------------------------------------------------------------------------------------------------------------------
# 3. Site settings (all optional)
# ---------------------------------------------------------------------------------------------------------------------
# Public origin, for canonical links and structured data (https://www.example.com). Empty outside development: omitted.
PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------------------------------------------------
# 4. Offers and delivery: no variables of their own (ADR-0013)
# ---------------------------------------------------------------------------------------------------------------------
# Offers and the delivery zone are read from Shopify itself: gifts from active automatic Buy X get Y discounts, the other
# offers and the zone from the offer_rule and delivery_zone metaobjects. They use SHOPIFY_ADMIN_API_ACCESS_TOKEN (section
# below) with the read_discounts, read_metaobjects and read_products scopes. Without that token there are no offers and no
# delivery zone, and the cart and checkout still work. To turn an offer off, deactivate its discount or rule in Shopify.

# ---------------------------------------------------------------------------------------------------------------------
# 5. Third-party features (all optional; each stays off while its variable is empty)
# ---------------------------------------------------------------------------------------------------------------------
# Analytics (always on for every id that is set; there is no consent banner or mode)
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_META_PIXEL_ID=
# OpenAI (ChatGPT ads) pixel id and a Google Tag Manager container id (GTM-XXXXXXX). Set PUBLIC_GA4_MEASUREMENT_ID too only
# if the container has no GA4 tag, or events are counted twice. See docs/integrations/ANALYTICS.md.
PUBLIC_OPENAI_PIXEL_ID=
PUBLIC_GTM_CONTAINER_ID=
# Chat: "tawk" (tawk.to; needs the two ids from the dashboard Widget Code, embed.tawk.to/<property id>/<widget id>)
# or "fake" (development only). Both ids are public.
PUBLIC_CHAT_PROVIDER=
PUBLIC_CHAT_REQUIRES_CONSENT=
PUBLIC_TAWK_PROPERTY_ID=
PUBLIC_TAWK_WIDGET_ID=
# Financing message: shop-pay-installments, affirm or store-card
PUBLIC_FINANCING_PROVIDER=
PUBLIC_AFFIRM_PUBLIC_KEY=
PUBLIC_AFFIRM_REQUIRES_CONSENT=
PUBLIC_AFFIRM_ENVIRONMENT=
STORE_CARD_MESSAGE=
# Extend protection (mock unless Extend gives real access)
PUBLIC_EXTEND_ENABLED=
PUBLIC_EXTEND_TERMS_URL=
PUBLIC_EXTEND_LOGO_URL=
EXTEND_API_HOST=
EXTEND_STORE_ID=
EXTEND_ACCESS_TOKEN=
EXTEND_ORDER_SYNC=
# Klaviyo email signup
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_LIST_ID=
PUBLIC_KLAVIYO_SMS_ENABLED=
# Reviews (judgeme)
REVIEWS_PROVIDER=
JUDGEME_PRIVATE_API_TOKEN=
JUDGEME_SHOP_DOMAIN=

# ---------------------------------------------------------------------------------------------------------------------
# 6. Guest order tracking and the Admin API (server only)
# ---------------------------------------------------------------------------------------------------------------------
# Header that carries the real client address behind a reverse proxy (x-real-ip behind nginx).
TRUSTED_CLIENT_IP_HEADER=
# Admin API access for everything the server reads or writes in Shopify: the order lookup, the Extend sync, the offer rules and gifts,
# and the newsletter customers. The token is taken on request, in this order:
#   1. SHOPIFY_ADMIN_API_ACCESS_TOKEN, if set: a fixed token, used as is (Shopify's own tokens last 24 hours, so this suits a
#      permanent token only).
#   2. ADMIN_CLIENT_ID and ADMIN_CLIENT_SECRET: a Dev Dashboard app's client id and secret. The server fetches its own token
#      from them and renews it before it expires; nothing to copy by hand.
# Either way it carries every scope its app has, which must include read_orders, read_products, read_discounts, read_metaobjects,
# write_customers and read_customers. Use an app made for the storefront, not the setup app. Server-only.
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
ADMIN_CLIENT_ID=
ADMIN_CLIENT_SECRET=
# The Dev Dashboard app's secret also verifies webhook signatures.
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
# Optional: extra carrier domains (comma-separated bare domains) that tracking links may point to, besides UPS, FedEx, USPS, DHL and OnTrac.
TRACKING_LINK_HOSTS=

# ---------------------------------------------------------------------------------------------------------------------
# 7. "Plan your visit" email (server only; CR-33, DEC-145, docs/integrations/VISIT_REQUESTS.md)
# ---------------------------------------------------------------------------------------------------------------------
# Each request from the home-page form is emailed over SMTP. This works on the plain-Node VPS only: Oxygen and `npm run dev`
# cannot open SMTP connections, and the form then says it cannot send. Without SMTP_HOST, SMTP_FROM and LEAD_EMAIL_TO the form
# says so too and nothing is faked. The password is a secret: environment only.
SMTP_HOST=
# Optional. Defaults: 587 for starttls, 465 for tls, 25 for none.
SMTP_PORT=
# starttls (default) | tls (implicit TLS, usually port 465) | none (no encryption and no login; a local mail catcher only).
SMTP_SECURITY=
# Optional pair: set both or neither. Not allowed with SMTP_SECURITY=none.
SMTP_USER=
SMTP_PASSWORD=
# The sender address the mail comes from (often the same mailbox as SMTP_USER).
SMTP_FROM=
# The one address that receives every request.
LEAD_EMAIL_TO=
# Optional. Comma-separated copies, up to 10: owner@example.com,manager@example.com
LEAD_EMAIL_CC=

# ---------------------------------------------------------------------------------------------------------------------
# NOT here: the SETUP scripts' credentials (scripts/setup/with-admin-token.sh reads the same two names, ADMIN_CLIENT_ID and
# ADMIN_CLIENT_SECRET, from the shell, or from your own git-ignored .env.demo as a local convenience). The setup app has write scopes
# for products, discounts and more: never put ITS secret in the storefront's server environment (use the customers-only app above).
# Keep setup credentials in the shell where you can, and rotate them after use.
# ---------------------------------------------------------------------------------------------------------------------
