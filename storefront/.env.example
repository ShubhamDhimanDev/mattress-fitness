# Names only. Never put values in this file and never commit a filled copy (.env and .env.* are git-ignored).
#
# Copy it to a file named for the mode you start, then fill it in:
#   storefront/.env.demo   ->   npm run dev -- --port 3400 --mode demo      (your development store)
#   storefront/.env        ->   npm run dev                                 (the default; mock.shop or your store)
# The full list with origins, and the scripts' own variables, are in ../.env.example and ../docs/deployment/DEPLOYMENT.md.
# A name with PUBLIC_ in front is sent to the browser; every other name is server-only.
# Secrets: generate one with  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---------------------------------------------------------------------------------------------------------------------
# 1. REQUIRED to start the storefront against a Shopify store
# ---------------------------------------------------------------------------------------------------------------------
# The store's <name>.myshopify.com domain.
PUBLIC_STORE_DOMAIN=
# The domain Shopify's hosted checkout answers on; for a development store the same myshopify.com domain.
PUBLIC_CHECKOUT_DOMAIN=
# The 32-character PUBLIC access token of the Hydrogen (or Headless) sales channel's storefront.
PUBLIC_STOREFRONT_API_TOKEN=
# Signs the session cookie. At least 32 random characters; the app refuses to serve without it.
SESSION_SECRET=
# Signs the delivery ZIP cookie. A DIFFERENT value from SESSION_SECRET, at least 32 random characters; shorter disables the ZIP cookie.
DELIVERY_COOKIE_SECRET=

# ---------------------------------------------------------------------------------------------------------------------
# 2. Customer accounts (sign-in). Leave empty and the account pages show a fixed "not available" page.
# ---------------------------------------------------------------------------------------------------------------------
PUBLIC_STOREFRONT_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
SHOP_ID=
# Server-side token of the storefront; only needed when the channel gives one.
PRIVATE_STOREFRONT_API_TOKEN=

# ---------------------------------------------------------------------------------------------------------------------
# 3. Site settings (all optional)
# ---------------------------------------------------------------------------------------------------------------------
# Public origin, for canonical links and structured data (https://www.example.com). Empty outside development: omitted.
PUBLIC_SITE_URL=
# Support phone (US number). No phone link shows until it is set; development shows a labelled placeholder.
PUBLIC_SUPPORT_PHONE=
# Handle of the Shopify navigation menu that drives the header (for example main-menu). Empty keeps the fixed navigation.
PUBLIC_NAV_MENU_HANDLE=

# ---------------------------------------------------------------------------------------------------------------------
# 4. Offers and delivery (optional; without them there are no offers and no delivery zone)
# ---------------------------------------------------------------------------------------------------------------------
# One line of JSON: the offer rules and the delivery zone. For the dev store, build it from storefront/.offer-config.local.json
# (git-ignored) with scripts/setup/demo-offers.mjs; see ../docs/integrations/OFFER_SETUP_DEVSTORE.md.
OFFER_CONFIG_JSON=
# The exact text "false" turns offers off on purpose. In production a missing or invalid OFFER_CONFIG_JSON pauses checkout instead.
OFFERS_ENABLED=
# The exact text "true" shows the gift picker. Turn it on only after the gift discount is verified on the store.
PUBLIC_GIFT_PICKER_ENABLED=

# ---------------------------------------------------------------------------------------------------------------------
# 5. Third-party features (all optional; each stays off while its variable is empty)
# ---------------------------------------------------------------------------------------------------------------------
# Analytics and consent
PUBLIC_CONSENT_MODE=
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_META_PIXEL_ID=
# Chat: "tawk" (tawk.to; needs the two ids from the dashboard Widget Code, embed.tawk.to/<property id>/<widget id>)
# or "fake" (development only). Both ids are public.
PUBLIC_CHAT_PROVIDER=
PUBLIC_CHAT_REQUIRES_CONSENT=
PUBLIC_TAWK_PROPERTY_ID=
PUBLIC_TAWK_WIDGET_ID=
# Financing message: shop-pay-installments, affirm or store-card
PUBLIC_FINANCING_PROVIDER=
PUBLIC_AFFIRM_PUBLIC_KEY=
PUBLIC_AFFIRM_REQUIRES_CONSENT=
PUBLIC_AFFIRM_ENVIRONMENT=
STORE_CARD_MESSAGE=
# Extend protection (mock unless Extend gives real access)
PUBLIC_EXTEND_ENABLED=
PUBLIC_EXTEND_TERMS_URL=
PUBLIC_EXTEND_LOGO_URL=
EXTEND_API_HOST=
EXTEND_STORE_ID=
EXTEND_ACCESS_TOKEN=
EXTEND_ORDER_SYNC=
# Klaviyo email signup
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_LIST_ID=
PUBLIC_KLAVIYO_SMS_ENABLED=
# Reviews (judgeme)
REVIEWS_PROVIDER=
JUDGEME_PRIVATE_API_TOKEN=
JUDGEME_SHOP_DOMAIN=

# ---------------------------------------------------------------------------------------------------------------------
# 6. Guest order tracking and the Admin API (server only)
# ---------------------------------------------------------------------------------------------------------------------
# Header that carries the real client address behind a reverse proxy (x-real-ip behind nginx).
TRUSTED_CLIENT_IP_HEADER=
# A SEPARATE read_orders-only Admin token for the order lookup and the Extend sync. Never the catalog or setup token.
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
# The Dev Dashboard app's secret also verifies webhook signatures.
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=

# ---------------------------------------------------------------------------------------------------------------------
# NOT here: the setup scripts' credentials (scripts/setup/with-admin-token.sh reads ADMIN_CLIENT_ID and ADMIN_CLIENT_SECRET from the
# shell, or from your own git-ignored .env.demo as a local convenience). Keep them in the shell where you can, and rotate them after use.
# ---------------------------------------------------------------------------------------------------------------------
